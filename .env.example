# Generate .env with new keys instead of copying this file:
#   ./scripts/init-env.sh <PUBLIC_RPC_URL> <ADMIN_RPC_URL> <CHAIN_TYPE>

# Tenderly Virtual Environment (Home tab > Integrate Virtual RPC)
TENDERLY_PUBLIC_RPC_URL=
TENDERLY_ADMIN_RPC_URL=

# Alto bundler. Throwaway keys, funded on start by the funder service.
ALTO_UTILITY_PRIVATE_KEY=
ALTO_EXECUTOR_PRIVATE_KEYS=
# op-stack for Base and OP Mainnet, default for Ethereum Mainnet and Arbitrum One
ALTO_CHAIN_TYPE=default

# Policy paymaster (docker compose --profile policy)
POLICY_SIGNER_PRIVATE_KEY=
POLICY_API_KEYS=
# Only sponsor calls to these targets (empty = any). Example 05 uses this one.
POLICY_ALLOWED_TARGETS=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045
POLICY_ALLOWED_SENDERS=
POLICY_MAX_SPEND_PER_SENDER_ETH=0.01
